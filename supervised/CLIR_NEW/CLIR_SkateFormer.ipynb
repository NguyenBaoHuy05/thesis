    "\n",
    "\n",
    "# 2. Bộ Trích Xuất Luật Nâng Cao Dựa Trên Attribution & Tối Ưu Hóa Surrogate\n",
    "class AttributionSurrogateRuleExtractor:\n",
    "    \"\"\"Bộ Trích Xuất Luật Nâng Cao Attribution-Guided Surrogate Extractor:\n",
    "    - Phân tích toàn bộ đường đi suy luận: Trọng số dương, trọng số âm, và bias ActionHead.\n",
    "    - Đóng góp thực nghiệm C_{a, j} = W_{a, j} * r_j trên Validation Set.\n",
    "    - Greedy Forward Selection để chọn 4 - 8 clauses tối ưu nhất cho từng Action.\n",
    "    - Chẩn đoán chi tiết từng Clause: Support, Precision, Logit Contribution, Ablation Impact.\n",
    "    - Ánh xạ 100% tên ngữ nghĩa thật từ Ontology (72 Concepts, 60 Actions).\n",
    "    \"\"\"\n",
    "    def __init__(\n",
    "        self,\n",
    "        reasoner,\n",
    "        concept_names=None,\n",
    "        action_names=None,\n",
    "        max_clauses_per_action: int = 6,\n",
    "        max_literals_per_clause: int = 6,\n",
    "        tau_attribution: float = 0.005,\n",
    "        complexity_penalty: float = 0.01,\n",
    "        include_negative_literals: bool = False,\n",
    "    ):\n",
    "        self.include_negative_literals = bool(include_negative_literals)\n",
    "        self.reasoner = reasoner\n",
    "        self.crl = reasoner.crl if hasattr(reasoner, \"crl\") else reasoner\n",
    "        self.n_concepts = getattr(self.crl, \"n_concepts\", 72)\n",
    "        self.n_actions = getattr(self.crl, \"n_actions\", 60)\n",
    "        self.r1 = getattr(self.crl, \"r1\", 128)\n",
    "        self.r2a = getattr(self.crl, \"r2a\", 64)\n",
    "        self.r2b = getattr(self.crl, \"r2b\", 64)\n",
    "        self.logic_dim = self.r1 + self.r2a + self.r2b  # 256\n",
    "\n",
    "        self.concept_names = concept_names or [f\"concept_{i}\" for i in range(self.n_concepts)]\n",
    "        self.action_names = action_names or [f\"action_{i}\" for i in range(self.n_actions)]\n",
    "        self.max_clauses_per_action = int(max_clauses_per_action)\n",
    "        self.max_literals_per_clause = int(max_literals_per_clause)\n",
    "        self.tau_attribution = float(tau_attribution)\n",
    "        self.complexity_penalty = float(complexity_penalty)\n",
    "\n",
    "        # Lưu trữ cấu trúc mệnh đề tượng trưng của 256 evidence nodes\n",
    "        self.evidence_templates = self._build_evidence_templates()\n",
    "\n",
    "        # Kết quả trích xuất & tối ưu\n",
    "        self.action_rules = {}\n",
    "        self.clause_diagnostics = {}\n",
    "        self.extraction_summary = {}\n",
    "\n",
    "    def _literal_to_name(self, lit_idx: int):\n",
    "        n = self.n_concepts\n",
    "        if lit_idx < n:\n",
    "            cname = self.concept_names[lit_idx] if lit_idx < len(self.concept_names) else f\"c_{lit_idx}\"\n",
    "            return cname, True   # Positive literal\n",
    "        else:\n",
    "            base_idx = lit_idx - n\n",
    "            cname = self.concept_names[base_idx] if base_idx < len(self.concept_names) else f\"c_{base_idx}\"\n",
    "            return cname, False  # Negative literal (NOT)\n",
    "\n",
    "    def _build_evidence_templates(self):\n",
    "        \"\"\"Xây dựng định nghĩa tượng trưng (symbolic expression) cho toàn bộ 256 nodes evidence.\n",
    "        Hỗ trợ loại bỏ hoàn toàn literal NOT khi include_negative_literals=False.\n",
    "        \"\"\"\n",
    "        templates = {}\n",
    "        w_and1 = self.crl.l1_and._effective_weights().clone()               # [144/72, 128]\n",
    "        w_rule_and2, w_skip_and2 = self.crl.l2a_and2._effective_weights()  # [128, 64], [144/72, 64]\n",
    "        w_rule_or1, w_skip_or1 = self.crl.l2b_or1._effective_weights()     # [128, 64], [144/72, 64]\n",
    "\n",
    "        # 1. 128 nodes L1 AND (96 Part + 32 Cross Top-5)\n",
    "        for j in range(self.r1):\n",
    "            col = w_and1[:, j]\n",
    "            if not self.include_negative_literals:\n",
    "                col_sub = col[:self.n_concepts]\n",
    "                top_lits = (col_sub > 0.01).nonzero(as_tuple=True)[0].tolist()\n",
    "                top_lits = sorted(top_lits, key=lambda i: -col_sub[i].item())[:self.max_literals_per_clause]\n",
    "            else:\n",
    "                top_lits = (col > 0.01).nonzero(as_tuple=True)[0].tolist()\n",
    "                top_lits = sorted(top_lits, key=lambda i: -col[i].item())[:self.max_literals_per_clause]\n",
    "            literals = [self._literal_to_name(l_idx) for l_idx in top_lits]\n",
    "            templates[j] = {\n",
    "                \"node_idx\": j,\n",
    "                \"type\": \"L1_AND\",\n",
    "                \"literals\": literals,\n",
    "                \"weights\": [col[l_idx].item() for l_idx in top_lits],\n",
    "            }\n",
    "\n",
    "        # 2. 64 nodes L2a AND2\n",
    "        for k in range(self.r2a):\n",
    "            j = self.r1 + k\n",
    "            col_rule = w_rule_and2[:, k]\n",
    "            col_skip = w_skip_and2[:, k]\n",
    "            top_rules = (col_rule > 0.01).nonzero(as_tuple=True)[0].tolist()\n",
    "            top_rules = sorted(top_rules, key=lambda i: -col_rule[i].item())[:3]\n",
    "            if not self.include_negative_literals:\n",
    "                col_skip_sub = col_skip[:self.n_concepts]\n",
    "                top_skips = (col_skip_sub > 0.01).nonzero(as_tuple=True)[0].tolist()\n",
    "                top_skips = sorted(top_skips, key=lambda i: -col_skip_sub[i].item())[:2]\n",
    "            else:\n",
    "                top_skips = (col_skip > 0.01).nonzero(as_tuple=True)[0].tolist()\n",
    "                top_skips = sorted(top_skips, key=lambda i: -col_skip[i].item())[:2]\n",
    "\n",
    "            raw_lits = []\n",
    "            for r_idx in top_rules:\n",
    "                raw_lits.extend(templates[r_idx][\"literals\"][:2])\n",
    "            for s_idx in top_skips:\n",
    "                raw_lits.append(self._literal_to_name(s_idx))\n",
    "\n",
    "            if not self.include_negative_literals:\n",
    "                raw_lits = [lit for lit in raw_lits if (isinstance(lit, tuple) and lit[1] is True) or isinstance(lit, str)]\n",
    "\n",
    "            seen = set()\n",
    "            unique_lits = []\n",
    "            for lit in raw_lits:\n",
    "                if lit not in seen:\n",
    "                    seen.add(lit)\n",
    "                    unique_lits.append(lit)\n",
    "            if len(unique_lits) > self.max_literals_per_clause:\n",
    "                unique_lits = unique_lits[:self.max_literals_per_clause]\n",
    "\n",
    "            templates[j] = {\n",
    "                \"node_idx\": j,\n",
    "                \"type\": \"L2_AND2\",\n",
    "                \"literals\": unique_lits,\n",
    "                \"input_rules\": top_rules,\n",
    "            }\n",
    "\n",
    "        # 3. 64 nodes L2b OR1\n",
    "        for k in range(self.r2b):\n",
    "            j = self.r1 + self.r2a + k\n",
    "            col_rule = w_rule_or1[:, k]\n",
    "            col_skip = w_skip_or1[:, k]\n",
    "            top_rules = (col_rule > 0.01).nonzero(as_tuple=True)[0].tolist()\n",
    "            top_rules = sorted(top_rules, key=lambda i: -col_rule[i].item())[:3]\n",
    "            if not self.include_negative_literals:\n",
    "                col_skip_sub = col_skip[:self.n_concepts]\n",
    "                top_skips = (col_skip_sub > 0.01).nonzero(as_tuple=True)[0].tolist()\n",
    "                top_skips = sorted(top_skips, key=lambda i: -col_skip_sub[i].item())[:2]\n",
    "            else:\n",
    "                top_skips = (col_skip > 0.01).nonzero(as_tuple=True)[0].tolist()\n",
    "                top_skips = sorted(top_skips, key=lambda i: -col_skip[i].item())[:2]\n",
    "\n",
    "            raw_lits = []\n",
    "            for r_idx in top_rules:\n",
    "                raw_lits.extend(templates[r_idx][\"literals\"][:2])\n",
    "            for s_idx in top_skips:\n",
    "                raw_lits.append(self._literal_to_name(s_idx))\n",
    "\n",
    "            if not self.include_negative_literals:\n",
    "                raw_lits = [lit for lit in raw_lits if (isinstance(lit, tuple) and lit[1] is True) or isinstance(lit, str)]\n",
    "\n",
    "            seen = set()\n",
    "            unique_lits = []\n",
    "            for lit in raw_lits:\n",
    "                if lit not in seen:\n",
    "                    seen.add(lit)\n",
    "                    unique_lits.append(lit)\n",
    "            if len(unique_lits) > self.max_literals_per_clause:\n",
    "                unique_lits = unique_lits[:self.max_literals_per_clause]\n",
    "\n",
    "            templates[j] = {\n",
    "                \"node_idx\": j,\n",
    "                \"type\": \"L2_OR1\",\n",
    "                \"literals\": unique_lits,\n",
    "                \"input_rules\": top_rules,\n",
    "            }\n",
    "\n",
    "        return templates\n",
    "\n",
    "    @torch.no_grad()\n",
    "    def compute_evidence_and_logits(self, all_z: torch.Tensor, device=None):\n",
    "        \"\"\"Tính toán vector bằng chứng r (256D) và logit y (60D) từ ma trận concept logits z.\"\"\"\n",
    "        if device is None:\n",
    "            device = next(self.crl.parameters()).device\n",
    "        all_z = all_z.to(device)\n",
    "        r_list = []\n",
    "        y_list = []\n",
    "        B = 256\n",
    "        N = all_z.shape[0]\n",
    "        for i in range(0, N, B):\n",
    "            batch_z = all_z[i:i+B]\n",
    "            r, y = self.crl(batch_z)\n",
    "            r_list.append(r.cpu())\n",
    "            y_list.append(y.cpu())\n",
    "        all_r = torch.cat(r_list, dim=0)\n",
    "        all_y = torch.cat(y_list, dim=0)\n",
    "        return all_r, all_y\n",
    "\n",
    "    @torch.no_grad()\n",
    "    def extract_and_optimize_rules(self, val_z: torch.Tensor, val_labels=None, device=None):\n",
    "        \"\"\"Trích xuất và tối ưu hóa luật bằng Attribution + Greedy Forward Selection trên Validation Set.\"\"\"\n",
    "        all_r, all_y = self.compute_evidence_and_logits(val_z, device=device)\n",
    "        model_preds = all_y.argmax(dim=-1)  # [N]\n",
    "        N = all_r.shape[0]\n",
    "\n",
    "        w_head = self.crl.action_head.weight.detach().cpu()  # [60, 256]\n",
    "        b_head = self.crl.action_head.bias.detach().cpu()    # [60]\n",
    "\n",
    "        action_rules = {}\n",
    "        clause_diag_all = {}\n",
    "        total_selected_clauses = 0\n",
    "\n",
    "        for a_idx in range(self.n_actions):\n",
    "            act_name = self.action_names[a_idx] if a_idx < len(self.action_names) else f\"action_{a_idx}\"\n",
    "            w_a = w_head[a_idx]  # [256]\n",
    "            b_a = b_head[a_idx].item()\n",
    "            y_target = all_y[:, a_idx]  # [N]\n",
    "\n",
    "            # 1. Tính Attribution thực nghiệm của từng node evidence\n",
    "            contrib_matrix = w_a.unsqueeze(0) * all_r  # [N, 256]\n",
    "            mask_a = (model_preds == a_idx)\n",
    "            count_a = mask_a.sum().item()\n",
    "\n",
    "            if count_a > 0:\n",
    "                mean_contrib_a = contrib_matrix[mask_a].mean(dim=0)  # [256]\n",
    "                freq_active_a = (all_r[mask_a] > 0.1).float().mean(dim=0)  # [256]\n",
    "            else:\n",
    "                mean_contrib_a = contrib_matrix.mean(dim=0)\n",
    "                freq_active_a = (all_r > 0.1).float().mean(dim=0)\n",
    "\n",
    "            attr_scores = mean_contrib_a * freq_active_a  # [256]\n",
    "\n",
    "            # 2. Tạo tập ứng viên (Candidate Pool: cả promoting và inhibiting)\n",
    "            pos_candidates = (attr_scores > self.tau_attribution).nonzero(as_tuple=True)[0].tolist()\n",
    "            pos_candidates = sorted(pos_candidates, key=lambda j: -attr_scores[j].item())[:12]\n",
    "\n",
    "            neg_candidates = (w_a < -0.05).nonzero(as_tuple=True)[0].tolist()\n",
    "            neg_candidates = sorted(neg_candidates, key=lambda j: attr_scores[j].item())[:6]\n",
    "\n",
    "            candidate_pool = pos_candidates + neg_candidates\n",
    "            if not candidate_pool:\n",
    "                candidate_pool = sorted(range(self.logic_dim), key=lambda j: -abs(w_a[j].item()))[:8]\n",
    "\n",
    "            # 3. Greedy Forward Selection: Lựa chọn các clauses giảm thiểu sai số bình phương Residual SSE\n",
    "            cur_approx_y = torch.full((N,), b_a)\n",
    "            selected_nodes = []\n",
    "\n",
    "            for step in range(self.max_clauses_per_action):\n",
    "                best_cand = None\n",
    "                best_reduction = 0.0\n",
    "                cur_err = ((y_target - cur_approx_y) ** 2).sum().item()\n",
    "\n",
    "                for cand in candidate_pool:\n",
    "                    if cand in selected_nodes:\n",
    "                        continue\n",
    "                    trial_y = cur_approx_y + contrib_matrix[:, cand]\n",
    "                    trial_err = ((y_target - trial_y) ** 2).sum().item()\n",
    "                    reduction = cur_err - trial_err\n",
    "                    if reduction > best_reduction:\n",
    "                        best_reduction = reduction\n",
    "                        best_cand = cand\n",
    "\n",
    "                if best_cand is not None and (best_reduction > 0.01 or step < 2):\n",
    "                    selected_nodes.append(best_cand)\n",
    "                    cur_approx_y = cur_approx_y + contrib_matrix[:, best_cand]\n",
    "                else:\n",
    "                    break\n",
    "\n",
    "            # 4. Hiệu chỉnh hệ số Ridge Regression trên tập clauses đã chọn\n",
    "            if selected_nodes:\n",
    "                X_sub = all_r[:, selected_nodes]\n",
    "                X_ext = torch.cat([X_sub, torch.ones(N, 1)], dim=-1)\n",
    "                reg = 1e-3 * torch.eye(X_ext.shape[1])\n",
    "                beta = torch.linalg.solve(X_ext.T @ X_ext + reg, X_ext.T @ y_target)\n",
    "                calibrated_weights = beta[:-1].tolist()\n",
    "                calibrated_bias = beta[-1].item()\n",
    "            else:\n",
    "                calibrated_weights = []\n",
    "                calibrated_bias = b_a\n",
    "\n",
    "            # 5. Tìm ngưỡng kích hoạt Boolean tối ưu trên Validation Set\n",
    "            optimal_tau = y_target[mask_a].median().item() if count_a > 0 else 0.0\n",
    "\n",
    "            # 6. Chẩn đoán chi tiết từng Clause\n",
    "            clauses_info = []\n",
    "            for idx_in_sel, c_node in enumerate(selected_nodes):\n",
    "                c_weight = calibrated_weights[idx_in_sel]\n",
    "                c_r = all_r[:, c_node]\n",
    "                c_support = (c_r > 0.2).sum().item()\n",
    "\n",
    "                if c_support > 0:\n",
    "                    if val_labels is not None:\n",
    "                        c_tp = ((c_r > 0.2) & (val_labels == a_idx)).sum().item()\n",
    "                    else:\n",
    "                        c_tp = ((c_r > 0.2) & (model_preds == a_idx)).sum().item()\n",
    "                    c_prec = (c_tp / c_support) * 100.0\n",
    "                else:\n",
    "                    c_prec = 0.0\n",
    "\n",
    "                ablated_y = cur_approx_y - contrib_matrix[:, c_node]\n",
    "                flips = ((ablated_y > optimal_tau) != (cur_approx_y > optimal_tau)).sum().item()\n",
    "\n",
    "                template = self.evidence_templates.get(c_node, {})\n",
    "                c_entry = {\n",
    "                    \"node_idx\": c_node,\n",
    "                    \"type\": template.get(\"type\", \"L1_AND\"),\n",
    "                    \"weight\": c_weight,\n",
    "                    \"raw_crl_weight\": w_a[c_node].item(),\n",
    "                    \"is_inhibitor\": (c_weight < 0),\n",
    "                    \"literals\": template.get(\"literals\", []),\n",
    "                    \"support\": c_support,\n",
    "                    \"precision\": c_prec,\n",
    "                    \"avg_contribution\": mean_contrib_a[c_node].item(),\n",
    "                    \"ablation_flips\": flips,\n",
    "                    \"is_dead_clause\": (c_support == 0 or flips == 0),\n",
    "                }\n",
    "                clauses_info.append(c_entry)\n",
    "                clause_diag_all[f\"act_{a_idx}_clause_{c_node}\"] = c_entry\n",
    "\n",
    "            action_rules[a_idx] = {\n",
    "                \"action_idx\": a_idx,\n",
    "                \"action_name\": act_name,\n",
    "                \"bias\": calibrated_bias,\n",
    "                \"raw_bias\": b_a,\n",
    "                \"optimal_tau\": optimal_tau,\n",
    "                \"clauses\": clauses_info,\n",
    "                \"selected_node_indices\": selected_nodes,\n",
    "                \"num_clauses\": len(clauses_info),\n",
    "            }\n",
    "            total_selected_clauses += len(clauses_info)\n",
    "\n",
    "        self.action_rules = action_rules\n",
    "        self.clause_diagnostics = clause_diag_all\n",
    "        self.extraction_summary = {\n",
    "            \"total_actions\": self.n_actions,\n",
    "            \"total_clauses\": total_selected_clauses,\n",
    "            \"avg_clauses_per_action\": total_selected_clauses / max(1, self.n_actions),\n",
    "            \"dead_clauses_count\": sum(1 for c in clause_diag_all.values() if c[\"is_dead_clause\"]),\n",
    "        }\n",
    "        return action_rules\n",
    "\n",
    "\n",
    "# 3. Công Cụ Đánh Giá 3 Cấp Độ Luật (Multi-Tier Rule Engine)\n",
    "class MultiTierRuleEngine:\n",
    "    \"\"\"Công cụ thực thi đánh giá 3 Cấp Độ Luật (Multi-Tier Rules):\n",
    "    Tier 1 (Exact Symbolic): Tái hiện 100% toán tử CRL (Full Continuous Evidence 256D).\n",
    "    Tier 2 (Fuzzy Surrogate): Rút gọn 4-8 clauses với giá trị mờ liên tục và weights tối ưu.\n",
    "    Tier 3 (Boolean Post-Hoc DNF): Rút gọn Boolean cứng với format DNF logic thuần túy.\n",
    "    \"\"\"\n",
    "    def __init__(self, action_rules, crl_reasoner, concept_names):\n",
    "        self.action_rules = action_rules\n",
    "        self.crl = crl_reasoner\n",
    "        self.concept_names = concept_names\n",
    "        self.n_concepts = getattr(crl_reasoner, \"n_concepts\", 72)\n",
    "        self.n_actions = getattr(crl_reasoner, \"n_actions\", 60)\n",
    "        self.concept_to_idx = {name: i for i, name in enumerate(concept_names)}\n",
    "\n",
    "    @torch.no_grad()\n",
    "    def evaluate_tier1_exact_symbolic(self, all_z: torch.Tensor, device=None):\n",
    "        \"\"\"Tier 1: Mô phỏng chính xác đường đi tính toán của CRL (Fidelity xấp xỉ 100%).\"\"\"\n",
    "        if device is None:\n",
    "            device = next(self.crl.parameters()).device\n",
    "        all_z = all_z.to(device)\n",
    "        r, y = self.crl(all_z)\n",
    "        preds = y.argmax(dim=-1).cpu()\n",
    "        return preds, y.cpu(), r.cpu()\n",
    "\n",
    "    @torch.no_grad()\n",
    "    def evaluate_tier2_fuzzy_surrogate(self, all_r: torch.Tensor):\n",
    "        \"\"\"Tier 2: Sử dụng tập luật rút gọn (4-8 clauses) với giá trị mờ liên tục.\"\"\"\n",
    "        N = all_r.shape[0]\n",
    "        fuzzy_logits = torch.zeros(N, self.n_actions)\n",
    "        for a_idx, rule in self.action_rules.items():\n",
    "            b_a = rule[\"bias\"]\n",
    "            logit_a = torch.full((N,), b_a)\n",
    "            for c in rule[\"clauses\"]:\n",
    "                node_idx = c[\"node_idx\"]\n",
    "                w = c[\"weight\"]\n",
    "                logit_a += w * all_r[:, node_idx]\n",
    "            fuzzy_logits[:, a_idx] = logit_a\n",
    "        preds = fuzzy_logits.argmax(dim=-1)\n",
    "        return preds, fuzzy_logits\n",
    "\n",
    "    @torch.no_grad()\n",
    "    def evaluate_tier3_boolean_posthoc(self, all_z: torch.Tensor):\n",
    "        \"\"\"Tier 3: Luật đại số Boolean nhị phân cứng format DNF.\"\"\"\n",
    "        N = all_z.shape[0]\n",
    "        hard_pos = (all_z > 0.0)\n",
    "        hard_neg = ~hard_pos\n",
    "        l_bin = torch.cat([hard_pos, hard_neg], dim=-1)  # [N, 144] bool\n",
    "\n",
    "        bool_logits = torch.zeros(N, self.n_actions)\n",
    "        for a_idx, rule in self.action_rules.items():\n",
    "            b_a = rule[\"bias\"]\n",
    "            logit_a = torch.full((N,), b_a)\n",
    "            for c in rule[\"clauses\"]:\n",
    "                w = c[\"weight\"]\n",
    "                lits = c[\"literals\"]\n",
    "                if not lits:\n",
    "                    continue\n",
    "                lit_indices = []\n",
    "                for cname, is_pos in lits:\n",
    "                    c_idx = self.concept_to_idx.get(cname, None)\n",
    "                    if c_idx is not None and c_idx < self.n_concepts:\n",
    "                        lit_indices.append(c_idx if is_pos else (c_idx + self.n_concepts))\n",
    "                if lit_indices:\n",
    "                    clause_active = l_bin[:, lit_indices].all(dim=-1).float()\n",
    "                    logit_a += w * clause_active\n",
    "            bool_logits[:, a_idx] = logit_a\n",
    "\n",
    "        preds = bool_logits.argmax(dim=-1)\n",
    "        return preds, bool_logits\n",
    "\n",
    "    @torch.no_grad()\n",
    "    def evaluate_benchmark(self, test_z: torch.Tensor, model_preds: torch.Tensor, true_labels: torch.Tensor):\n",
    "        \"\"\"Đánh giá và đối sánh toàn diện cả 3 Tiers trên Test Set.\"\"\"\n",
    "        N = test_z.shape[0]\n",
    "        model_preds = model_preds.cpu()\n",
    "        true_labels = true_labels.cpu()\n",
    "\n",
    "        t1_preds, t1_logits, all_r = self.evaluate_tier1_exact_symbolic(test_z)\n",
    "        t1_fidelity = (t1_preds == model_preds).float().mean().item() * 100.0\n",
    "        t1_acc = (t1_preds == true_labels).float().mean().item() * 100.0\n",
    "\n",
    "        t2_preds, t2_logits = self.evaluate_tier2_fuzzy_surrogate(all_r)\n",
    "        t2_fidelity = (t2_preds == model_preds).float().mean().item() * 100.0\n",
    "        t2_acc = (t2_preds == true_labels).float().mean().item() * 100.0\n",
    "\n",
    "        t3_preds, t3_logits = self.evaluate_tier3_boolean_posthoc(test_z)\n",
    "        t3_fidelity = (t3_preds == model_preds).float().mean().item() * 100.0\n",
    "        t3_acc = (t3_preds == true_labels).float().mean().item() * 100.0\n",
    "\n",
    "        return {\n",
    "            \"tier1_exact\": {\"fidelity\": t1_fidelity, \"acc\": t1_acc},\n",
    "            \"tier2_fuzzy\": {\"fidelity\": t2_fidelity, \"acc\": t2_acc},\n",
    "            \"tier3_bool\":  {\"fidelity\": t3_fidelity, \"acc\": t3_acc},\n",
    "        }\n",
    "\n",
    "    def format_action_rule(self, rule: dict) -> str:\n",
    "        \"\"\"Định dạng luật action rõ ràng với tên Ontology thật, hiển thị Promoting và Inhibiting clauses.\"\"\"\n",
    "        act_name = rule[\"action_name\"]\n",
    "        lines = [\n",
    "            \"=\" * 80,\n",
    "            f\"HÀNH ĐỘNG: '{act_name}' (idx={rule['action_idx']}) | Base Bias: {rule['bias']:+.3f} | Optimal Tau: {rule['optimal_tau']:+.3f}\",\n",
    "            \"=\" * 80,\n",
    "        ]\n",
    "\n",
    "        pos_clauses = [c for c in rule[\"clauses\"] if not c[\"is_inhibitor\"]]\n",
    "        neg_clauses = [c for c in rule[\"clauses\"] if c[\"is_inhibitor\"]]\n",
    "\n",
    "        lines.append(f\"[MỆNH ĐỀ KHẲNG ĐỊNH / PROMOTING CLAUSES ({len(pos_clauses)})]:\")\n",
    "        if pos_clauses:\n",
    "            for i, c in enumerate(pos_clauses, 1):\n",
    "                lit_str = \" ∧ \".join([name if is_pos else f\"NOT {name}\" for name, is_pos in c[\"literals\"]])\n",
    "                diag = f\"supp={c['support']}, prec={c['precision']:.1f}%, flips={c['ablation_flips']}\"\n",
    "                lines.append(f\"  • Clause {i} [{c['type']}, w={c['weight']:+.3f} | {diag}]:\\n      ({lit_str if lit_str else 'TRUE'})\")\n",
    "        else:\n",
    "            lines.append(\"  (Không có mệnh đề khẳng định)\")\n",
    "\n",
    "        lines.append(f\"\\n[MỆNH ĐỀ PHỦ ĐỊNH / INHIBITING CLAUSES ({len(neg_clauses)})]:\")\n",
    "        if neg_clauses:\n",
    "            for i, c in enumerate(neg_clauses, 1):\n",
    "                lit_str = \" ∧ \".join([name if is_pos else f\"NOT {name}\" for name, is_pos in c[\"literals\"]])\n",
    "                diag = f\"supp={c['support']}, prec={c['precision']:.1f}%, flips={c['ablation_flips']}\"\n",
    "                lines.append(f\"  • Counter-Clause {i} [{c['type']}, w={c['weight']:+.3f} | {diag}]:\\n      ({lit_str if lit_str else 'TRUE'})\")\n",
    "        else:\n",
    "            lines.append(\"  (Không có mệnh đề phủ định)\")\n",
    "\n",
    "        return \"\\n\".join(lines)\n",
    "\n",
    "    def save_rules(self, output_dir=\"rules_output\"):\n",
    "        os.makedirs(output_dir, exist_ok=True)\n",
    "        json_path = os.path.join(output_dir, \"attribution_rules.json\")\n",
    "        with open(json_path, \"w\", encoding=\"utf-8\") as f:\n",
    "            json.dump(self.action_rules, f, indent=2, ensure_ascii=False)\n",
    "\n",
    "        txt_path = os.path.join(output_dir, \"attribution_rules.txt\")\n",
    "        with open(txt_path, \"w\", encoding=\"utf-8\") as f:\n",
    "            f.write(\"=\" * 80 + \"\\n\")\n",
    "            f.write(\"TẬP LUẬT TƯỢNG TRƯNG ATTRIBUTION-GUIDED SURROGATE RULES (CLIR-SKATEFORMER)\\n\")\n",
    "            f.write(\"=\" * 80 + \"\\n\\n\")\n",
    "            for r in self.action_rules.values():\n",
    "                f.write(self.format_action_rule(r) + \"\\n\\n\")\n",
    "        print(f\"✓ Đã lưu thành công tập luật vào '{output_dir}':\")\n",
    "        print(f\"  • JSON: {json_path}\")\n",
    "        print(f\"  • TXT:  {txt_path}\")\n",
    "\n",
    "\n",
