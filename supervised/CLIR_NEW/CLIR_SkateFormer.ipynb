    "                    generator=torch.Generator().manual_seed(42)\n",
    "                )\n",
    "            else:\n",
    "                val_sz = min(val_samples, total_test_raw // 2)\n",
    "                test_sz = min(test_samples, total_test_raw - val_sz)\n",
    "                rem_sz = total_test_raw - val_sz - test_sz\n",
