    }
   ],
   "source": [
    "# ==============================================================================\n",
    "# BLOCK 34: THỰC THI ABLATION STUDY - HUẤN LUYỆN & ĐỐI SÁNH CLIR KHÔNG DÙNG NOT\n",
    "# ==============================================================================\n",
    "\n",
    "import os\n",
    "import sys\n",
    "import json\n",
    "import time\n",
    "import math\n",
    "import copy\n",
    "import numpy as np\n",
    "import torch\n",
    "import torch.nn as nn\n",
    "import torch.nn.functional as F\n",
    "from torch.utils.data import DataLoader, TensorDataset\n",
    "\n",
    "def run_ablation_no_not_study(\n",
    "    baseline_model=None,\n",
    "    data_path=\"/kaggle/input/datasets/nguyenbaohuy05/ntu60-cs-64f/NTU60_CS_64f.npz\",\n",
    "    concepts_csv=\"concepts/ntu_rgbd_60_120.csv\",\n",
    "    pretrained_path=\"/kaggle/input/datasets/nguyenbaohuy05/skateformer-pretrain/ntu60_CSub/SkateFormer_j.pt\",\n",
    "    epochs: int = 15,\n",
    "    batch_size: int = 32,\n",
    "    lr: float = 1e-3,\n",
    "    mode: str = \"fast\",\n",
    "    val_samples: int = 2000,\n",
    "    test_samples = None,\n",
    "    output_dir: str = \"rules_output\",\n",
    "    device = None\n",
    "):\n",
    "    \"\"\"Thực thi nghiên cứu thực nghiệm Ablation Study: Positive-Only vs Dual Literals.\"\"\"\n",
    "    if device is None:\n",
    "        device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\n",
    "    \n",
    "    print(\"=\" * 80)\n",
    "    print(\"🔬 [ABLATION STUDY] BẮT ĐẦU ĐỐI SÁNH: BASELINE (DUAL LITERALS) VS NO-NOT (POSITIVE-ONLY)\")\n",
    "    print(\"=\" * 80)\n",
    "    print(f\"[Cấu hình]: Mode={mode} | Epochs={epochs} | BatchSize={batch_size} | Device={device}\")\n",
    "    \n",
    "    os.makedirs(output_dir, exist_ok=True)\n",
    "    \n",
    "    # 1. Nạp danh mục khái niệm\n",
    "    concept_names, action_names = load_ontology_names(concepts_csv)\n",
    "    n_concepts = len(concept_names)\n",
    "    n_actions = len(action_names)\n",
    "    \n",
    "    # 2. Chuẩn bị DataLoader\n",
    "    real_data = None\n",
    "    if os.path.exists(data_path):\n",
    "        try:\n",
    "            print(f\"[Data] Đang nạp dataset thật: {data_path}...\")\n",
    "            real_data = np.load(data_path, mmap_mode='r')\n",
    "            x_train = real_data['x_train']\n",
    "            y_train = real_data['y_train']\n",
    "            x_test = real_data['x_test']\n",
    "            y_test = real_data['y_test']\n",
    "            print(f\"  ✓ Train: {x_train.shape} | Test: {x_test.shape}\")\n",
    "        except Exception as e:\n",
    "            print(f\"  ⚠️ Lỗi khi nạp dataset: {e}. Sử dụng dữ liệu mô phỏng.\")\n",
    "            real_data = None\n",
    "\n",
    "    if real_data is not None:\n",
    "        n_val = min(val_samples, len(x_train) // 10)\n",
    "        indices = np.random.RandomState(42).permutation(len(x_train))\n",
    "        val_idx, train_idx = indices[:n_val], indices[n_val:]\n",
    "        \n",
    "        train_loader = DataLoader(\n",
    "            NTURealDatasetFeeder(x_train, y_train, train_idx),\n",
    "            batch_size=batch_size, shuffle=True, drop_last=True\n",
    "        )\n",
    "        val_loader = DataLoader(\n",
    "            NTURealDatasetFeeder(x_train, y_train, val_idx),\n",
    "            batch_size=batch_size, shuffle=False\n",
    "        )\n",
    "        test_cnt = len(x_test) if test_samples is None else min(test_samples, len(x_test))\n",
    "        test_loader = DataLoader(\n",
    "            NTURealDatasetFeeder(x_test, y_test, np.arange(test_cnt)),\n",
    "            batch_size=batch_size, shuffle=False\n",
    "        )\n",
    "    else:\n",
    "        print(\"[Data] Khởi tạo dữ liệu giả lập chuẩn để chạy thử nghiệm pipeline...\")\n",
    "        n_train, n_val, n_test = 200, 100, 100\n",
    "        x_tr = torch.randn(n_train, 3, 64, 24, 2)\n",
    "        y_tr = torch.randint(0, n_actions, (n_train,))\n",
    "        train_loader = DataLoader(TensorDataset(x_tr, y_tr), batch_size=batch_size, shuffle=True)\n",
    "        val_loader = DataLoader(TensorDataset(torch.randn(n_val, 3, 64, 24, 2), torch.randint(0, n_actions, (n_val,))), batch_size=batch_size)\n",
    "        test_loader = DataLoader(TensorDataset(torch.randn(n_test, 3, 64, 24, 2), torch.randint(0, n_actions, (n_test,))), batch_size=batch_size)\n",
    "\n",
    "    # 3. Xác định lớp mô hình\n",
    "    model_cls = globals().get('CLIRSkateFormer', baseline_model.__class__ if baseline_model is not None else None)\n",
    "    if model_cls is None:\n",
    "        raise ValueError(\"Không tìm thấy class mô hình CLIRSkateFormer.\")\n",
    "\n",
    "    # 4. Khởi tạo Baseline Model nếu chưa có\n",
    "    if baseline_model is None:\n",
    "        print(\"\\n[Baseline] Khởi tạo mô hình Baseline CLIRSkateFormer (use_negative_literals=True)...\")\n",
    "        baseline_model = model_cls(\n",
    "            num_classes=n_actions,\n",
    "            num_concepts=n_concepts,\n",
    "            use_negative_literals=True\n",
    "        ).to(device)\n",
    "    else:\n",
    "        print(\"\\n[Baseline] Kế thừa mô hình Baseline đã huấn luyện từ bộ nhớ.\")\n",
    "        baseline_model = baseline_model.to(device)\n",
    "\n",
    "    # 5. Khởi tạo Ablation Model (No-NOT: use_negative_literals=False)\n",
    "    print(\"\\n[Ablation] Khởi tạo mô hình Ablation CLIRSkateFormer (use_negative_literals=False - Positive Only)...\")\n",
    "    ablation_model = model_cls(\n",
    "        num_classes=n_actions,\n",
    "        num_concepts=n_concepts,\n",
    "        use_negative_literals=False\n",
    "    ).to(device)\n",
    "\n",
    "    # Đồng bộ hóa trọng số Perception (Backbone + ML-Decoder) nếu có\n",
    "    if hasattr(baseline_model, 'perception') and hasattr(ablation_model, 'perception'):\n",
    "        print(\"[Ablation] Đồng bộ hóa trọng số Perception (Backbone + ML-Decoder) từ Baseline sang Ablation...\")\n",
    "        ablation_model.perception.load_state_dict(baseline_model.perception.state_dict())\n",
    "\n",
    "    # 6. Huấn luyện mô hình Ablation\n",
    "    print(f\"\\n[Ablation Training] Bắt đầu huấn luyện mô hình No-NOT (Mode: {mode})...\")\n",
    "    if mode == \"fast\" and hasattr(ablation_model, 'perception') and hasattr(ablation_model, 'reasoner'):\n",
    "        for param in ablation_model.perception.parameters():\n",
    "            param.requires_grad = False\n",
    "        optimizer = torch.optim.AdamW(ablation_model.reasoner.parameters(), lr=lr, weight_decay=1e-4)\n",
    "    else:\n",
    "        optimizer = torch.optim.AdamW(ablation_model.parameters(), lr=lr, weight_decay=1e-4)\n",
    "\n",
    "    criterion = nn.CrossEntropyLoss()\n",
    "    scheduler_cls = globals().get('TemperatureScheduler', None)\n",
    "    if scheduler_cls is not None:\n",
    "        scheduler_t = scheduler_cls(t_start=2.0, t_end=8.0, total_epochs=epochs, delay_ratio=0.5)\n",
    "    else:\n",
    "        scheduler_t = None\n",
    "\n",
    "    ablation_model.train()\n",
    "    start_time = time.time()\n",
    "    for ep in range(epochs):\n",
    "        curr_t = scheduler_t.get_temperature(ep) if scheduler_t is not None else 2.0\n",
    "        # Cập nhật temperature nếu reasoner có literal_layer\n",
    "        if hasattr(ablation_model, 'reasoner') and hasattr(ablation_model.reasoner, 'crl') and hasattr(ablation_model.reasoner.crl, 'literal_layer'):\n",
    "            ablation_model.reasoner.crl.literal_layer.set_temperature(curr_t)\n",
    "        \n",
    "        ep_loss = 0.0\n",
    "        n_batches = 0\n",
    "        for batch in train_loader:\n",
    "            if isinstance(batch, (tuple, list)):\n",
    "                bx, by = batch[0].to(device), batch[1].to(device)\n",
    "            else:\n",
    "                bx, by = batch[\"data\"].to(device), batch[\"label\"].to(device)\n",
    "            \n",
    "            optimizer.zero_grad()\n",
    "            out = ablation_model(bx)\n",
    "            loss = criterion(out[\"y_final\"], by)\n",
    "            loss.backward()\n",
    "            optimizer.step()\n",
    "            \n",
    "            ep_loss += loss.item()\n",
    "            n_batches += 1\n",
    "            if n_batches >= 20 and mode == \"fast\":\n",
    "                break\n",
    "\n",
    "        if (ep + 1) % max(1, epochs // 5) == 0 or ep == epochs - 1:\n",
    "            print(f\"  • Epoch {ep+1:02d}/{epochs:02d} | Temp: {curr_t:.2f} | Loss: {ep_loss/max(1,n_batches):.4f}\")\n",
    "\n",
    "    print(f\"  ✓ Huấn luyện Ablation hoàn tất trong {time.time() - start_time:.1f}s.\")\n",
    "\n",
    "    # 7. Trích xuất luật cho cả 2 mô hình\n",
    "    print(\"\\n\" + \"=\" * 80)\n",
    "    print(\"📊 [BƯỚC ĐÁNH GIÁ & ĐỐI SÁNH]: TRÍCH XUẤT LUẬT & ĐO LƯỜNG TEST FIDELITY\")\n",
    "    print(\"=\" * 80)\n",
    "\n",
    "    def get_eval_tensors(m, loader):\n",
    "        m.eval()\n",
    "        all_z, all_preds, all_y = [], [], []\n",
    "        with torch.no_grad():\n",
    "            for batch in loader:\n",
    "                if isinstance(batch, (tuple, list)):\n",
    "                    bx, by = batch[0].to(device), batch[1].to(device)\n",
    "                else:\n",
    "                    bx, by = batch[\"data\"].to(device), batch[\"label\"].to(device)\n",
    "                out = m(bx)\n",
    "                all_z.append(out[\"z_final\"].cpu())\n",
    "                all_preds.append(out[\"y_final\"].argmax(dim=-1).cpu())\n",
    "                all_y.append(by.cpu())\n",
    "        return torch.cat(all_z, dim=0), torch.cat(all_preds, dim=0), torch.cat(all_y, dim=0)\n",
    "\n",
    "    val_z_base, _, _ = get_eval_tensors(baseline_model, val_loader)\n",
    "    test_z_base, test_preds_base, test_y = get_eval_tensors(baseline_model, test_loader)\n",
    "\n",
    "    val_z_abl, _, _ = get_eval_tensors(ablation_model, val_loader)\n",
    "    test_z_abl, test_preds_abl, _ = get_eval_tensors(ablation_model, test_loader)\n",
    "\n",
    "    crl_base = baseline_model.reasoner.crl if hasattr(baseline_model, 'reasoner') and hasattr(baseline_model.reasoner, 'crl') else baseline_model\n",
    "    crl_abl = ablation_model.reasoner.crl if hasattr(ablation_model, 'reasoner') and hasattr(ablation_model.reasoner, 'crl') else ablation_model\n",
    "\n",
    "    # Baseline extractor\n",
    "    ext_base = AttributionSurrogateRuleExtractor(\n",
    "        crl_base, concept_names, action_names,\n",
    "        include_negative_literals=True\n",
    "    )\n",
    "    rules_base = ext_base.extract_and_optimize_rules(val_z_base)\n",
    "    engine_base = MultiTierRuleEngine(rules_base, crl_base, concept_names)\n",
    "    bench_base = engine_base.evaluate_benchmark(test_z_base, test_preds_base, test_y)\n",
    "\n",
    "    # Ablation extractor (Positive-Only)\n",
    "    ext_abl = AttributionSurrogateRuleExtractor(\n",
    "        crl_abl, concept_names, action_names,\n",
    "        include_negative_literals=False\n",
    "    )\n",
    "    rules_abl = ext_abl.extract_and_optimize_rules(val_z_abl)\n",
    "    engine_abl = MultiTierRuleEngine(rules_abl, crl_abl, concept_names)\n",
    "    bench_abl = engine_abl.evaluate_benchmark(test_z_abl, test_preds_abl, test_y)\n",
    "\n",
    "    # 8. Phân tích thống kê mệnh đề\n",
    "    def analyze_rule_set(rules):\n",
    "        total_clauses = 0\n",
    "        total_lits = 0\n",
    "        not_lits = 0\n",
    "        for r in rules.values():\n",
    "            for c in r[\"clauses\"]:\n",
    "                total_clauses += 1\n",
    "                for lit in c[\"literals\"]:\n",
    "                    total_lits += 1\n",
    "                    if isinstance(lit, tuple) and not lit[1]:\n",
    "                        not_lits += 1\n",
    "        avg_lits = (total_lits / max(1, total_clauses))\n",
    "        not_pct = (not_lits / max(1, total_lits)) * 100.0\n",
    "        return total_clauses, avg_lits, not_pct\n",
    "\n",
    "    cl_base, lits_base, not_pct_base = analyze_rule_set(rules_base)\n",
    "    cl_abl, lits_abl, not_pct_abl = analyze_rule_set(rules_abl)\n",
    "\n",
    "    # 9. In Bảng Đối Sánh Head-to-Head\n",
    "    acc_base = (test_preds_base == test_y).float().mean().item() * 100.0\n",
    "    acc_abl = (test_preds_abl == test_y).float().mean().item() * 100.0\n",
    "\n",
    "    print(\"\\n\" + \"=\" * 95)\n",
    "    print(\"🏆 BẢNG TỔNG KẾT THỰC NGHIỆM ABLATION STUDY: DUAL LITERALS VS POSITIVE-ONLY (NO-NOT)\")\n",
    "    print(\"=\" * 95)\n",
    "    print(f\"| {'Chỉ số đánh giá (Evaluation Metric)':<38} | {'Baseline (Dual Literals)':<24} | {'Ablation (No-NOT)':<22} |\")\n",
    "    print(\"|\" + \"-\" * 40 + \"|\" + \"-\" * 26 + \"|\" + \"-\" * 24 + \"|\")\n",
    "    print(f\"| {'Top-1 Action Accuracy (Mô hình nơ-ron)':<38} | {acc_base:>22.2f}% | {acc_abl:>20.2f}% |\")\n",
    "    print(f\"| {'Tier 1 Exact Symbolic Fidelity':<38} | {bench_base['tier1_exact']['fidelity']:>22.2f}% | {bench_abl['tier1_exact']['fidelity']:>20.2f}% |\")\n",
    "    print(f\"| {'Tier 2 Fuzzy Surrogate Fidelity':<38} | {bench_base['tier2_fuzzy']['fidelity']:>22.2f}% | {bench_abl['tier2_fuzzy']['fidelity']:>20.2f}% |\")\n",
    "    print(f\"| {'Tier 3 Boolean Post-hoc DNF Fidelity':<38} | {bench_base['tier3_bool']['fidelity']:>22.2f}% | {bench_abl['tier3_bool']['fidelity']:>20.2f}% |\")\n",
    "    print(f\"| {'Số lượng Clause trung bình / Action':<38} | {(cl_base/n_actions):>24.1f} | {(cl_abl/n_actions):>22.1f} |\")\n",
    "    print(f\"| {'Số Literal trung bình / Clause':<38} | {lits_base:>24.2f} | {lits_abl:>22.2f} |\")\n",
    "    print(f\"| {'Tỷ lệ Literal Phủ Định (NOT Literals)':<38} | {not_pct_base:>22.1f}% | {not_pct_abl:>20.1f}% |\")\n",
    "    print(f\"| {'Mức độ minh bạch & Khả năng diễn giải':<38} | {'Trung bình (Nhiều NOT)':>24} | {'RẤT CAO (100% Khẳng định)':>22} |\")\n",
    "    print(\"=\" * 95)\n",
    "\n",
    "    # 10. Lưu kết quả ra file\n",
    "    comparison_results = {\n",
    "        \"baseline\": {\n",
    "            \"accuracy\": acc_base,\n",
    "            \"benchmark\": bench_base,\n",
    "            \"avg_literals_per_clause\": lits_base,\n",
    "            \"not_literal_percentage\": not_pct_base\n",
    "        },\n",
    "        \"ablation_no_not\": {\n",
    "            \"accuracy\": acc_abl,\n",
    "            \"benchmark\": bench_abl,\n",
    "            \"avg_literals_per_clause\": lits_abl,\n",
    "            \"not_literal_percentage\": not_pct_abl\n",
    "        }\n",
    "    }\n",
    "    json_path = os.path.join(output_dir, \"ablation_no_not_comparison.json\")\n",
    "    with open(json_path, \"w\", encoding=\"utf-8\") as f:\n",
    "        json.dump(comparison_results, f, indent=2, ensure_ascii=False)\n",
    "    print(f\"✓ Đã lưu bảng dữ liệu thực nghiệm vào '{json_path}'.\")\n",
    "\n",
    "    txt_path = os.path.join(output_dir, \"ablation_no_not_rules.txt\")\n",
    "    with open(txt_path, \"w\", encoding=\"utf-8\") as f:\n",
    "        f.write(\"=\" * 80 + \"\\n\")\n",
    "        f.write(\"TẬP LUẬT KHÔNG CHỨA NOT (ABLATION POSITIVE-ONLY RULES)\\n\")\n",
    "        f.write(\"=\" * 80 + \"\\n\\n\")\n",
