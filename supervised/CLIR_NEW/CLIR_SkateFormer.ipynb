      "Cell \u001b[1;32mIn[32], line 43\u001b[0m, in \u001b[0;36mrun_ablation_no_not_study\u001b[1;34m(baseline_model, data_path, concepts_csv, pretrained_path, epochs, batch_size, lr, mode, val_samples, test_samples, output_dir, device)\u001b[0m\n\u001b[0;32m     40\u001b[0m os\u001b[38;5;241m.\u001b[39mmakedirs(output_dir, exist_ok\u001b[38;5;241m=\u001b[39m\u001b[38;5;28;01mTrue\u001b[39;00m)\n\u001b[0;32m     42\u001b[0m \u001b[38;5;66;03m# 1. Nạp danh mục khái niệm\u001b[39;00m\n\u001b[1;32m---> 43\u001b[0m concept_names, action_names \u001b[38;5;241m=\u001b[39m \u001b[43mload_ontology_names\u001b[49m(concepts_csv)\n\u001b[0;32m     44\u001b[0m n_concepts \u001b[38;5;241m=\u001b[39m \u001b[38;5;28mlen\u001b[39m(concept_names)\n\u001b[0;32m     45\u001b[0m n_actions \u001b[38;5;241m=\u001b[39m \u001b[38;5;28mlen\u001b[39m(action_names)\n",
