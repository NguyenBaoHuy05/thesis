    "    for v1, v2 in NTU_BONES:\n",
    "        if v1 < V and v2 < V:\n",
    "            ax1.plot([x[v1], x[v2]], [y[v1], y[v2]], 'b-', alpha=0.6, linewidth=2)\n",
    "            \n",
    "    ax1.set_title(f\"Khung xuong (T={frame_idx}, Person={person_idx})\", fontsize=12, fontweight='bold')\n",
