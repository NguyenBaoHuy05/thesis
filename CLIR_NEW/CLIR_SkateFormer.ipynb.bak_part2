    "print(f\"[Visualizer] Hien thi truc quan cho mau 0 (Action: {sample_label}):\")\n",
    "visualize_skeleton_and_concepts(sample_data, sample_label, ontology, frame_idx=0, person_idx=0)\n"
   ]
