        <mxCell id="n-70" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#000000;exitX=1;exitY=0.1625;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="g-87" target="g-139"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="formula" value='&lt;i&gt;&lt;font face=&quot;Comic Sans MS&quot; style=&quot;font-size: 18px;&quot;&gt;L = L&lt;sub&gt;action&lt;/sub&gt; + α·L&lt;sub&gt;retr&lt;/sub&gt; + β·L&lt;sub&gt;attr&lt;/sub&gt;   (α = β = 0.5; L&lt;sub&gt;attr&lt;/sub&gt; = BCE(p, KG) trên ô KG đã biết)&lt;/font&gt;&lt;/i&gt;' style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="950" y="1300" width="820" height="40" as="geometry"/></mxCell>
        <mxCell id="n-71" value='&lt;font style=&quot;font-size: 12px;&quot;&gt;&lt;b&gt;Hiện trạng (seed 0, nhiễu 4):&lt;/b&gt;&lt;br&gt;• Node học từ đầu, không Text Encoder. G1 ≈ G1-0: R-GCN chưa giúp retrieval.&lt;br&gt;• VERIFY chỉ dùng thuộc tính đối lập có vị từ; p đo từ tọa độ khớp, không từ z.&lt;br&gt;• Full / K2: λ 1.42 / 0.59, AUC thuộc tính 0.85 / 0.53, Top1 87.10 / 87.07.&lt;br&gt;• Kẹt: 66% lỗi ở test là hòa (cặp khó không có thuộc tính đối lập có vị từ) → đang thử lọc vị từ theo cặp KG.&lt;br&gt;Không FUSE, không zero-shot.&lt;/font&gt;' style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1630" y="820" width="175" height="330" as="geometry"/></mxCell>
      <mxCell id="u-1" value='&lt;font style=&quot;font-size: 12px;&quot;&gt;&lt;b&gt;Nhiễu (chỉ train)&lt;/b&gt;&lt;br&gt;z + 4·σ·ε&lt;/font&gt;' style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="770" y="48" width="140" height="42" as="geometry"/></mxCell>
        <mxCell id="u-2" value='&lt;font style=&quot;font-size: 12px;&quot;&gt;Chọn vị từ (chỉ train): AUC trong cặp KG ≥ 0.75&lt;/font&gt;' style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5f0ec;strokeColor=#00796b;" vertex="1" parent="1"><mxGeometry x="340" y="538" width="345" height="26" as="geometry"/></mxCell>
        <mxCell id="u-3" value='&lt;font style=&quot;font-size: 15px;&quot;&gt;&lt;i&gt;L&lt;/i&gt;&lt;sub&gt;attr&lt;/sub&gt; = BCE(&lt;i&gt;p&lt;/i&gt;, KG) → θ, s&lt;/font&gt;' style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="540" y="394" width="240" height="32" as="geometry"/></mxCell>
        <mxCell id="u-4" value='&lt;font style=&quot;font-size: 13px;&quot;&gt;Headroom&lt;br&gt;v đúng vs đối thủ&lt;/font&gt;' style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5f0ec;strokeColor=#00796b;" vertex="1" parent="1"><mxGeometry x="1465" y="790" width="120" height="45" as="geometry"/></mxCell>
        <mxCell id="u-1e" style="endArrow=classic;html=1;dashed=1;strokeColor=#666666;" edge="1" parent="1" source="u-1" target="n-7"><mxGeometry relative="1" as="geometry"/></mxCell>
        </root>
    </mxGraphModel>
  </diagram>
