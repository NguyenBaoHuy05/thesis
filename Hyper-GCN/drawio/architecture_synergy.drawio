        <mxCell id="sb-1" value='&lt;font style="font-size: 16px;"&gt;&lt;b&gt;Skeleton&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 12px;"&gt;[N,3,T,25,M]&lt;/font&gt;&lt;/font&gt;' style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="110" height="60" as="geometry"/></mxCell>
        <mxCell id="sb-2" value='&lt;font style="font-size: 16px;"&gt;&lt;b&gt;① Frozen Hyper-GCN&lt;/b&gt;&lt;/font&gt;&lt;font style="font-size: 12px;"&gt;  pretrained, BN in eval&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;strokeWidth=2;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;arcSize=4;" vertex="1" parent="1"><mxGeometry x="175" y="45" width="420" height="130" as="geometry"/></mxCell>
