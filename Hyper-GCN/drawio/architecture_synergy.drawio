        <mxCell id="sb-50" value='&lt;font style="font-size: 16px;"&gt;&lt;b&gt;③ Explanation &amp;amp; Evaluation&lt;/b&gt;&lt;/font&gt;&lt;font style="font-size: 12px;"&gt;  (logits = Σ contrib exactly)&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;strokeWidth=2;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="510" width="1500" height="125" as="geometry"/></mxCell>
