          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eb4" value="P_raw" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;strokeColor=#004d40;strokeWidth=2;fontSize=9;" edge="1" parent="p_b" source="b_temp" target="b_gate">
          <mxGeometry relative="1" as="geometry" />
