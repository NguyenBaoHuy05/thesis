        <!-- ==================================================================== -->
        <!-- ====== PANEL (d): TAXONOMIC ONTOLOGY & LOSSES ====== -->
        <!-- ==================================================================== -->
        <mxCell id="p_d" value="(d) Taxonomic Ontology &amp;amp; Multi-Task Supervision" style="swimlane;startSize=28;fillColor=#f8f9fa;strokeColor=#7b1fa2;fontStyle=1;fontSize=13;container=1;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="1030" y="530" width="890" height="470" as="geometry" />
        </mxCell>

        <!-- Ontology Hierarchy -->
        <mxCell id="d_prim" value="&lt;b&gt;Primitive Concepts (L0)&lt;/b&gt;&lt;br&gt;&amp;bull; Spatial: arm_raise, kick, crouch&lt;br&gt;&amp;bull; Temporal: fast_motion, rising&lt;br&gt;&amp;bull; Interaction: person_touch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#7b1fa2;fontSize=9;" vertex="1" parent="p_d">
          <mxGeometry x="25" y="42" width="240" height="75" as="geometry" />
        </mxCell>

        <mxCell id="d_par" value="&lt;b&gt;Taxonomic Parents (L1)&lt;/b&gt;&lt;br&gt;&amp;bull; UpperBody_Motion&lt;br&gt;&amp;bull; LowerBody_Locomotion&lt;br&gt;&amp;bull; Person_Interaction" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1bee7;strokeColor=#6a1b9a;fontSize=9;" vertex="1" parent="p_d">
          <mxGeometry x="325" y="42" width="240" height="75" as="geometry" />
        </mxCell>

        <mxCell id="d_act" value="&lt;b&gt;Target Actions (L2)&lt;/b&gt;&lt;br&gt;&amp;bull; Jump, Wave, Cheer&lt;br&gt;&amp;bull; Kick, Walk, Bend&lt;br&gt;&amp;bull; Hug, Handshake, Push" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a237e;strokeColor=#0d47a1;fontColor=#ffffff;fontSize=9;" vertex="1" parent="p_d">
          <mxGeometry x="625" y="42" width="235" height="75" as="geometry" />
        </mxCell>

        <!-- Losses Row 1 -->
        <mxCell id="d_l_ce" value="&lt;b&gt;Action Loss L_{CE}&lt;/b&gt;&lt;br&gt;Cross-Entropy on Action Logits&lt;br&gt;-log softmax(S_{y*})" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#e65100;fontSize=9;" vertex="1" parent="p_d">
          <mxGeometry x="25" y="145" width="255" height="60" as="geometry" />
        </mxCell>
        <mxCell id="d_l_hn" value="&lt;b&gt;Hard-Negative Loss L_{HN}&lt;/b&gt;&lt;br&gt;max(0, m + S_{neg} - S_{pos})&lt;br&gt;Separates confusable action pairs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#e65100;fontSize=9;" vertex="1" parent="p_d">
          <mxGeometry x="315" y="145" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="d_l_c" value="&lt;b&gt;Concept BCE Loss L_{concept}&lt;/b&gt;&lt;br&gt;Weak concept supervision&lt;br&gt;Matches ontology support M_c" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#e65100;fontSize=9;" vertex="1" parent="p_d">
          <mxGeometry x="605" y="145" width="255" height="60" as="geometry" />
        </mxCell>

        <!-- Losses Row 2 -->
        <mxCell id="d_l_par" value="&lt;b&gt;Parent Loss L_{parent}&lt;/b&gt;&lt;br&gt;Coarse taxonomy supervision&lt;br&gt;-log sigmoid(parent_logits)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#e65100;fontSize=9;" vertex="1" parent="p_d">
          <mxGeometry x="25" y="225" width="255" height="60" as="geometry" />
        </mxCell>
        <mxCell id="d_l_hie" value="&lt;b&gt;Hierarchy Loss L_{hier}&lt;/b&gt;&lt;br&gt;ReLU(P_raw(c) - P(parent_c))&lt;br&gt;Child prob &amp;le; Parent prob" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#e65100;fontSize=9;" vertex="1" parent="p_d">
          <mxGeometry x="315" y="225" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="d_l_den" value="&lt;b&gt;Density Loss L_{density}&lt;/b&gt;&lt;br&gt;|sum(P_c) - budget_target|&lt;br&gt;Prevents concept over-activation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#e65100;fontSize=9;" vertex="1" parent="p_d">
          <mxGeometry x="605" y="225" width="255" height="60" as="geometry" />
        </mxCell>

        <!-- Total Loss Box -->
        <mxCell id="d_l_tot" value="&lt;b&gt;Total Multi-Task Objective Function&lt;/b&gt;&lt;br&gt;L_{total} = L_{CE} + &amp;alpha;&amp;middot;L_{HN} + &amp;beta;&amp;middot;L_{concept} + &amp;gamma;&amp;middot;L_{parent} + &amp;delta;&amp;middot;L_{hier} + &amp;eta;&amp;middot;L_{density}&lt;br&gt;&amp;bull; End-to-end differentiable neuro-symbolic optimization with exact semantic grounding" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe0b2;strokeColor=#e65100;fontStyle=1;fontSize=10;" vertex="1" parent="p_d">
          <mxGeometry x="25" y="315" width="835" height="65" as="geometry" />
        </mxCell>

        <mxCell id="d_ft" value="&lt;b&gt;Thesis Contribution&lt;/b&gt;: Relation-free unary grounding + taxonomic gating eliminates O(K^2) pairwise relation explosion, delivering state-of-the-art accuracy with interpretable decision paths." style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=10;fontStyle=2;fontColor=#455a64;" vertex="1" parent="p_d">
          <mxGeometry x="25" y="405" width="835" height="35" as="geometry" />
        </mxCell>

        <!-- Panel (d) edges -->
        <mxCell id="ed1" value="gated by" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#7b1fa2;strokeWidth=2;fontSize=9;fontColor=#6a1b9a;" edge="1" parent="p_d" source="d_prim" target="d_par">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ed2" value="composed into" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#7b1fa2;strokeWidth=2;fontSize=9;fontColor=#6a1b9a;" edge="1" parent="p_d" source="d_par" target="d_act">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
