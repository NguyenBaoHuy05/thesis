          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ==================================================================== -->
        <!-- ====== PANEL (c): SYMBOLIC DECODER DETAIL ====== -->
        <!-- ==================================================================== -->
        <mxCell id="p_c" value="(c) Hierarchical Symbolic Decoder (Detail)" style="swimlane;startSize=28;fillColor=#f8f9fa;strokeColor=#f57f17;fontStyle=1;fontSize=13;container=1;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="530" width="960" height="470" as="geometry" />
        </mxCell>

        <!-- Concept Row -->
        <mxCell id="c_in_c" value="&lt;b&gt;Concept Evidences P(c)&lt;/b&gt;&lt;br&gt;From Concept Decoder [B, K]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe082;strokeColor=#f57f17;fontSize=10;" vertex="1" parent="p_c">
          <mxGeometry x="245" y="38" width="195" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c_supp_c" value="&lt;b&gt;Weak Support M_c&lt;/b&gt;&lt;br&gt;Action-Concept Matrix&lt;br&gt;M_{a,c} &amp;isin; {0, 1}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#f57f17;fontSize=10;" vertex="1" parent="p_c">
          <mxGeometry x="25" y="100" width="180" height="55" as="geometry" />
        </mxCell>
        <mxCell id="c_w_c" value="&lt;b&gt;Concept Weights W_c &amp;ge; 0&lt;/b&gt;&lt;br&gt;W_c = softplus(W_{raw}) &amp;odot; M_c&lt;br&gt;Strictly positive support" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe082;strokeColor=#f57f17;fontSize=10;" vertex="1" parent="p_c">
          <mxGeometry x="245" y="100" width="195" height="55" as="geometry" />
        </mxCell>
        <mxCell id="c_sc_c" value="&lt;b&gt;Normalized Concept Score&lt;/b&gt;&lt;br&gt;S_c(a) = &amp;sum;_c P(c) &amp;times; W_{c,a} / Z_c&lt;br&gt;Fine-grained evidence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffd54f;strokeColor=#ff8f00;fontSize=10;" vertex="1" parent="p_c">
          <mxGeometry x="480" y="65" width="215" height="70" as="geometry" />
        </mxCell>

        <!-- Parent Row -->
        <mxCell id="c_in_p" value="&lt;b&gt;Parent Evidences P(p)&lt;/b&gt;&lt;br&gt;From Parent Heads [B, K_par]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe082;strokeColor=#f57f17;fontSize=10;" vertex="1" parent="p_c">
          <mxGeometry x="245" y="185" width="195" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c_supp_p" value="&lt;b&gt;Parent Support M_p&lt;/b&gt;&lt;br&gt;Taxon Support Matrix&lt;br&gt;M_{a,p} &amp;isin; {0, 1}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#f57f17;fontSize=10;" vertex="1" parent="p_c">
          <mxGeometry x="25" y="245" width="180" height="55" as="geometry" />
        </mxCell>
        <mxCell id="c_w_p" value="&lt;b&gt;Parent Weights W_p &amp;ge; 0&lt;/b&gt;&lt;br&gt;W_p = softplus(W_{raw}^{(p)}) &amp;odot; M_p&lt;br&gt;Coarse taxon evidence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe082;strokeColor=#f57f17;fontSize=10;" vertex="1" parent="p_c">
          <mxGeometry x="245" y="245" width="195" height="55" as="geometry" />
        </mxCell>
        <mxCell id="c_sc_p" value="&lt;b&gt;Normalized Parent Score&lt;/b&gt;&lt;br&gt;S_p(a) = &amp;sum;_p P(p) &amp;times; W_{p,a} / Z_p&lt;br&gt;Coarse taxonomic evidence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffd54f;strokeColor=#ff8f00;fontSize=10;" vertex="1" parent="p_c">
          <mxGeometry x="480" y="210" width="215" height="70" as="geometry" />
        </mxCell>

        <!-- Compositional Scoring -->
        <mxCell id="c_agg" value="&lt;b&gt;Hierarchical Compositional Scoring&lt;/b&gt;&lt;br&gt;S(a) = S_c(a) + &amp;lambda; &amp;times; S_p(a) + b_a&lt;br&gt;&amp;bull; &amp;lambda; = 0.35 (taxonomic weight)&lt;br&gt;&amp;bull; Action Logits S &amp;in; R^{B &amp;times; A}&lt;br&gt;&amp;rarr; Interpretable Decision Rule" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffcc02;strokeColor=#e65100;fontStyle=1;fontSize=10;" vertex="1" parent="p_c">
          <mxGeometry x="725" y="115" width="215" height="120" as="geometry" />
        </mxCell>

        <mxCell id="c_note" value="&lt;b&gt;Interpretability &amp;amp; Open-World Logic Guarantees&lt;/b&gt;&lt;br&gt;&amp;bull; &lt;b&gt;Strictly Positive Weights&lt;/b&gt;: Active concepts contribute monotonically to action evidence; no contradictory negative weights.&lt;br&gt;&amp;bull; &lt;b&gt;Open-World Support&lt;/b&gt;: Zero in support matrix = Unknown (open-world), not a hard negative penalty.&lt;br&gt;&amp;bull; &lt;b&gt;Rule Extraction&lt;/b&gt;: Explanations can be read out directly: Action(a) &amp;larr; Concept_1(w_1) &amp;and; Concept_2(w_2) &amp;and; Parent(w_p)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#f57f17;fontSize=10;align=left;" vertex="1" parent="p_c">
          <mxGeometry x="25" y="340" width="915" height="105" as="geometry" />
        </mxCell>

        <!-- Panel (c) edges -->
        <mxCell id="ec1" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;strokeColor=#f57f17;strokeWidth=2;" edge="1" parent="p_c" source="c_in_c" target="c_sc_c">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ec2" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#f57f17;strokeWidth=2;" edge="1" parent="p_c" source="c_supp_c" target="c_w_c">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ec3" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;strokeColor=#f57f17;strokeWidth=2;" edge="1" parent="p_c" source="c_w_c" target="c_sc_c">
