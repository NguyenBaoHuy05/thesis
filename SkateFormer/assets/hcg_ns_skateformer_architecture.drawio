  <diagram id="hcg-ns-full" name="HCG-NS-SkateFormer">
    <mxGraphModel dx="1960" dy="1040" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1960" pageHeight="1040" math="0" shadow="0" background="#F8F9FA">
