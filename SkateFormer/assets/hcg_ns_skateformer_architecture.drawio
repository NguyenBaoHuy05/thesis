        <!-- ==================================================================== -->
        <mxCell id="p_b" value="(b) Hierarchical Concept Decoder (Detail)" style="swimlane;startSize=28;fillColor=#f8f9fa;strokeColor=#00695c;fontStyle=1;fontSize=13;container=1;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="1030" y="55" width="890" height="450" as="geometry" />
        </mxCell>

        <!-- Branch 1: Prototype Grounding -->
        <mxCell id="b_tokens" value="&lt;b&gt;Token Projection&lt;/b&gt;&lt;br&gt;z = norm(Proj(&amp;Phi;(X)))&lt;br&gt;[B, T, V, D]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b2dfdb;strokeColor=#004d40;fontSize=10;" vertex="1" parent="p_b">
          <mxGeometry x="25" y="42" width="185" height="55" as="geometry" />
        </mxCell>
        <mxCell id="b_proto" value="&lt;b&gt;Concept Prototypes&lt;/b&gt;&lt;br&gt;C_k &amp;isin; R^D (k=1..K)&lt;br&gt;Normalized centers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b2dfdb;strokeColor=#004d40;fontSize=10;" vertex="1" parent="p_b">
          <mxGeometry x="25" y="107" width="185" height="55" as="geometry" />
        </mxCell>

        <mxCell id="b_sim" value="&lt;b&gt;Prototype Matching&lt;/b&gt;&lt;br&gt;sim = z &amp;middot; C_k / &amp;tau;&lt;br&gt;&amp;bull; Soft Joint Attention:&lt;br&gt;attn_V = softmax_V(sim)&lt;br&gt;&amp;rarr; time_logits [B, T, K]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#80cbc4;strokeColor=#004d40;fontSize=10;" vertex="1" parent="p_b">
          <mxGeometry x="245" y="55" width="205" height="90" as="geometry" />
        </mxCell>

        <mxCell id="b_temp" value="&lt;b&gt;Temporal Statistics&lt;/b&gt;&lt;br&gt;time_probs = &amp;sigma;(time_logits)&lt;br&gt;&amp;bull; Peak, Duration, Rising&lt;br&gt;&amp;bull; Cumulative Sequence Prob:&lt;br&gt;P_raw = 1 - &amp;prod; (1 - p_t)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#80cbc4;strokeColor=#004d40;fontSize=10;" vertex="1" parent="p_b">
          <mxGeometry x="485" y="55" width="200" height="90" as="geometry" />
        </mxCell>

        <!-- Branch 2: Scope & Parent Heads -->
        <mxCell id="b_pool" value="&lt;b&gt;Global Avg Pooling&lt;/b&gt;&lt;br&gt;z_bar = mean_{T,V}(&amp;Phi;(X))&lt;br&gt;[B, D]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f7fa;strokeColor=#006064;fontSize=10;" vertex="1" parent="p_b">
          <mxGeometry x="25" y="225" width="185" height="55" as="geometry" />
        </mxCell>

        <mxCell id="b_scope" value="&lt;b&gt;Taxonomic Scope Heads&lt;/b&gt;&lt;br&gt;LN + Linear &amp;rarr; scope_logits&lt;br&gt;&lt;i&gt;Modulates prototype scale&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f7fa;strokeColor=#006064;fontSize=10;" vertex="1" parent="p_b">
          <mxGeometry x="245" y="225" width="205" height="55" as="geometry" />
        </mxCell>

        <mxCell id="b_parent" value="&lt;b&gt;Taxonomic Parent Heads&lt;/b&gt;&lt;br&gt;LN + Linear &amp;rarr; parent_probs&lt;br&gt;&lt;i&gt;P(parent) [B, K_par]&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f7fa;strokeColor=#006064;fontSize=10;" vertex="1" parent="p_b">
          <mxGeometry x="485" y="225" width="200" height="55" as="geometry" />
        </mxCell>

        <!-- Soft Gate & Output -->
        <mxCell id="b_gate" value="&lt;b&gt;Taxonomic Soft Gate&lt;/b&gt;&lt;br&gt;Gate = g_fl + (1-g_fl)&amp;middot;P_p&lt;br&gt;P(c) = Gate &amp;times; P_raw" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b2ebf2;strokeColor=#006064;fontStyle=1;fontSize=10;" vertex="1" parent="p_b">
          <mxGeometry x="715" y="95" width="155" height="95" as="geometry" />
        </mxCell>

        <mxCell id="b_out" value="&lt;b&gt;Grounding Output&lt;/b&gt;&lt;br&gt;&amp;bull; P(concepts) [B, K]&lt;br&gt;&amp;bull; P(parents) [B, K_par]&lt;br&gt;&amp;bull; Temporal Stats" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#004d40;strokeColor=#00251a;fontColor=#ffffff;fontStyle=1;fontSize=10;" vertex="1" parent="p_b">
          <mxGeometry x="715" y="225" width="155" height="85" as="geometry" />
        </mxCell>

        <mxCell id="b_note" value="&lt;b&gt;Core Advantage&lt;/b&gt;: Unary concept prototypes ground temporal features efficiently without pairwise relation explosion (O(K) instead of O(K^2)). Continuous soft parent gating prevents discontinuous classification drops under taxonomic uncertainty." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2f1;strokeColor=#00695c;fontSize=10;align=left;" vertex="1" parent="p_b">
          <mxGeometry x="25" y="340" width="845" height="85" as="geometry" />
        </mxCell>

        <!-- Panel (b) edges -->
