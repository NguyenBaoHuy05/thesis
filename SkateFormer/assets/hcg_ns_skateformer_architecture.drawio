        <mxCell id="a_inp" value="&lt;b&gt;Skeleton Sequence&lt;/b&gt;&lt;br&gt;X &amp;isin; R^{B &amp;times; C &amp;times; T &amp;times; V &amp;times; M}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" vertex="1" parent="p_a">
