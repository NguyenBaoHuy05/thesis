        <mxCell id="ec7" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;strokeColor=#e65100;strokeWidth=2;" edge="1" parent="p_c" source="c_sc_c" target="c_agg">
          <mxGeometry relative="1" as="geometry" />
