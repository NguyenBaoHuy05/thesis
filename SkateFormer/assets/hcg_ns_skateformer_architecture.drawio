        <mxCell id="eb6" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#006064;strokeWidth=2;" edge="1" parent="p_b" source="b_scope" target="b_parent">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eb7" value="P_par" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;strokeColor=#006064;strokeWidth=2;fontSize=9;" edge="1" parent="p_b" source="b_parent" target="b_gate">
          <mxGeometry relative="1" as="geometry" />
